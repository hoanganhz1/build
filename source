-- ===== HÀM XÓA BLOCK THỰC TẾ =====
function xoa_block_with_params(radius, height)
    if not ClientCurGame or not ClientCurGame:isInGame() then
        ShowGameTipsWithoutFilter("#cFF0000Chưa vào phòng!")
        return
    end

    local x, y, z = CurMainPlayer:getPosition(0, 0, 0)
    local gridX = math.floor(x / 100)
    local gridY = math.floor(y / 100)
    local gridZ = math.floor(z / 100)

    local startPos = {
        x = gridX - radius,
        y = gridY,                -- Không xóa block dưới chân (gridY-1)
        z = gridZ - radius
    }
    local endPos = {
        x = gridX + radius,
        y = gridY + height - 1,
        z = gridZ + radius
    }

    local tdata = {
        [1] = "area",
        [2] = "clearAllBlockAreaRange",
        [3] = { startPos, endPos, 0 }
    }
    pcall(function()
        ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, tdata)
    end)

    local sizeX = radius * 2 + 1
    local sizeZ = radius * 2 + 1
    ShowGameTipsWithoutFilter(string.format("#c00ff00Đã xóa vùng %dx%dx%d quanh bạn!", sizeX, height, sizeZ))
end
